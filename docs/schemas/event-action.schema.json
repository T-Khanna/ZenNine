{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zennine.local/schemas/event-action.schema.json",
  "title": "ZenNine Event Action",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/SetDigitAction" },
    { "$ref": "#/$defs/ClearDigitAction" },
    { "$ref": "#/$defs/CandidateAction" },
    { "$ref": "#/$defs/SetColorAction" },
    { "$ref": "#/$defs/SetLetterAction" },
    { "$ref": "#/$defs/SetModeAction" },
    { "$ref": "#/$defs/ConflictModeChangeAction" },
    { "$ref": "#/$defs/UndoRedoAction" },
    { "$ref": "#/$defs/CheckpointAction" }
  ],
  "$defs": {
    "CellId": {
      "type": "string",
      "pattern": "^r[1-9][0-9]*c[1-9][0-9]*$"
    },
    "CellIdList": {
      "type": "array",
      "items": { "$ref": "#/$defs/CellId" },
      "minItems": 1,
      "uniqueItems": true
    },
    "Symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "Lane": {
      "type": "string",
      "enum": ["center", "side"]
    },
    "SelectionSource": {
      "type": "string",
      "enum": ["drag", "row", "column", "box", "manual", "keyboard"]
    },
    "SetDigitAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "set_digit" },
        "payload": {
          "type": "object",
          "required": ["targetCells", "value"],
          "properties": {
            "targetCells": { "$ref": "#/$defs/CellIdList" },
            "value": { "$ref": "#/$defs/Symbol" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ClearDigitAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "clear_digit" },
        "payload": {
          "type": "object",
          "required": ["targetCells"],
          "properties": {
            "targetCells": { "$ref": "#/$defs/CellIdList" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "CandidateAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": {
          "type": "string",
          "enum": ["set_candidates", "toggle_candidate"]
        },
        "payload": {
          "type": "object",
          "required": ["targetCells", "lane"],
          "properties": {
            "targetCells": { "$ref": "#/$defs/CellIdList" },
            "lane": { "$ref": "#/$defs/Lane" },
            "value": { "$ref": "#/$defs/Symbol" },
            "values": {
              "type": "array",
              "items": { "$ref": "#/$defs/Symbol" },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": true,
          "oneOf": [
            {
              "properties": {
                "actionType": { "const": "toggle_candidate" },
                "value": { "$ref": "#/$defs/Symbol" }
              },
              "required": ["value"]
            },
            {
              "properties": {
                "actionType": { "const": "set_candidates" },
                "values": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/Symbol" },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": ["values"]
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "SetColorAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "set_color" },
        "payload": {
          "type": "object",
          "required": ["targetCells", "value"],
          "properties": {
            "targetCells": { "$ref": "#/$defs/CellIdList" },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "SetLetterAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "set_letter" },
        "payload": {
          "type": "object",
          "required": ["targetCells", "value"],
          "properties": {
            "targetCells": { "$ref": "#/$defs/CellIdList" },
            "value": { "type": "string", "minLength": 1, "maxLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "SetModeAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "set_mode" },
        "payload": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "enum": ["digit", "candidate", "color", "letter"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ConflictModeChangeAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "conflict_mode_change" },
        "payload": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "enum": ["off", "soft", "strict"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "UndoRedoAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "type": "string", "enum": ["undo", "redo"] },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "CheckpointAction": {
      "type": "object",
      "required": ["actionType", "payload"],
      "properties": {
        "actionType": { "const": "checkpoint" },
        "payload": {
          "type": "object",
          "properties": {
            "label": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
