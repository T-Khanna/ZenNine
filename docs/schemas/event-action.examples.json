{
  "description": "Examples that conform to event-action.schema.json",
  "examples": [
    {
      "name": "toggle center candidate across one cell",
      "event": {
        "actionType": "toggle_candidate",
        "payload": {
          "targetCells": ["r4c7"],
          "lane": "center",
          "value": "6"
        }
      }
    },
    {
      "name": "set side candidates across one cell",
      "event": {
        "actionType": "set_candidates",
        "payload": {
          "targetCells": ["r4c7"],
          "lane": "side",
          "values": ["1", "4", "9"]
        }
      }
    },
    {
      "name": "toggle center candidate across drag selection",
      "event": {
        "actionType": "toggle_candidate",
        "payload": {
          "targetCells": ["r2c1", "r2c2", "r2c4"],
          "lane": "center",
          "value": "6",
          "selectionSource": "drag"
        }
      }
    },
    {
      "name": "set side candidates across box selection",
      "event": {
        "actionType": "set_candidates",
        "payload": {
          "targetCells": ["r7c4", "r7c5", "r7c6"],
          "lane": "side",
          "values": ["2", "8"],
          "selectionSource": "box"
        }
      }
    },
    {
      "name": "place digit across row selection",
      "event": {
        "actionType": "set_digit",
        "payload": {
          "targetCells": ["r1c1", "r1c2"],
          "value": "5",
          "selectionSource": "row"
        }
      }
    },
    {
      "name": "clear digit across manual selection",
      "event": {
        "actionType": "clear_digit",
        "payload": {
          "targetCells": ["r3c3", "r3c4"],
          "selectionSource": "manual"
        }
      }
    },
    {
      "name": "mode switch to candidate",
      "event": {
        "actionType": "set_mode",
        "payload": {
          "value": "candidate"
        }
      }
    },
    {
      "name": "set digit across keyboard selection",
      "event": {
        "actionType": "set_digit",
        "payload": {
          "targetCells": ["r5c1", "r5c2", "r5c3"],
          "value": "7",
          "selectionSource": "keyboard"
        }
      }
    }
  ]
}
